<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 2 · Central de Desafios.
     NestedScrollView como raiz com UM único filho direto (LinearLayout vertical):
     o ScrollView só aceita um filho. layoutAnimation aplica a entrada em cascata (anim XML). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rolagemCentral"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tela"
    android:fillViewport="true"
    tools:context=".CentralActivity">

    <LinearLayout
        android:id="@+id/containerCentral"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutAnimation="@anim/layout_cascata"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imagemLogoCentral"
                android:layout_width="@dimen/icone_cabecalho"
                android:layout_height="@dimen/icone_cabecalho"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/Texto.Arcade.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_p"
                android:text="@string/central_overline" />
        </LinearLayout>

        <TextView
            android:id="@+id/textoSaudacao"
            style="@style/Texto.Arcade.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_g"
            tools:text="Olá, jogador!" />

        <TextView
            android:id="@+id/textoSubtitulo"
            style="@style/Texto.Arcade.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_xs"
            android:text="@string/central_subtitulo" />

        <TextView
            android:id="@+id/textoUltimoModulo"
            style="@style/Texto.Arcade.Legenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_m"
            android:fontFamily="monospace"
            android:textColor="@color/neon_amarelo"
            tools:text="Nenhum desafio aberto nesta sessão." />

        <!-- Painel 1 · Scanner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_g"
            app:strokeColor="@color/neon_ciano">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/espaco_g">

                <ImageView
                    android:id="@+id/imagemScanner"
                    android:layout_width="@dimen/icone_painel"
                    android:layout_height="@dimen/icone_painel"
                    android:contentDescription="@string/cd_scanner"
                    android:src="@drawable/ic_scanner"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tituloScanner"
                    style="@style/Texto.Arcade.Secao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_g"
                    android:text="@string/painel_scanner_titulo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imagemScanner"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tagScanner"
                    style="@style/Texto.Arcade.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/painel_scanner_tag"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloScanner"
                    app:layout_constraintTop_toBottomOf="@id/tituloScanner" />

                <TextView
                    android:id="@+id/descricaoScanner"
                    style="@style/Texto.Arcade.Corpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_p"
                    android:text="@string/painel_scanner_descricao"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloScanner"
                    app:layout_constraintTop_toBottomOf="@id/tagScanner" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoAbrirScanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_m"
                    android:text="@string/painel_scanner_botao"
                    android:textColor="@color/texto_sobre_neon"
                    app:backgroundTint="@color/neon_ciano"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloScanner"
                    app:layout_constraintTop_toBottomOf="@id/descricaoScanner" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Painel 2 · Arena -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelArena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_g"
            app:strokeColor="@color/neon_magenta">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/espaco_g">

                <ImageView
                    android:id="@+id/imagemArena"
                    android:layout_width="@dimen/icone_painel"
                    android:layout_height="@dimen/icone_painel"
                    android:contentDescription="@string/cd_arena"
                    android:src="@drawable/ic_tesoura"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tituloArena"
                    style="@style/Texto.Arcade.Secao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_g"
                    android:text="@string/painel_arena_titulo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imagemArena"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tagArena"
                    style="@style/Texto.Arcade.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/painel_arena_tag"
                    android:textColor="@color/neon_magenta"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloArena"
                    app:layout_constraintTop_toBottomOf="@id/tituloArena" />

                <TextView
                    android:id="@+id/descricaoArena"
                    style="@style/Texto.Arcade.Corpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_p"
                    android:text="@string/painel_arena_descricao"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloArena"
                    app:layout_constraintTop_toBottomOf="@id/tagArena" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoAbrirArena"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_m"
                    android:text="@string/painel_arena_botao"
                    android:textColor="@color/texto_sobre_neon"
                    app:backgroundTint="@color/neon_magenta"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloArena"
                    app:layout_constraintTop_toBottomOf="@id/descricaoArena" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Painel 3 · Código Secreto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelCofre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_g"
            app:strokeColor="@color/neon_laranja">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/espaco_g">

                <ImageView
                    android:id="@+id/imagemCofre"
                    android:layout_width="@dimen/icone_painel"
                    android:layout_height="@dimen/icone_painel"
                    android:contentDescription="@string/cd_cofre"
                    android:src="@drawable/ic_cofre"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tituloCofre"
                    style="@style/Texto.Arcade.Secao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_g"
                    android:text="@string/painel_cofre_titulo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imagemCofre"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tagCofre"
                    style="@style/Texto.Arcade.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/painel_cofre_tag"
                    android:textColor="@color/neon_laranja"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloCofre"
                    app:layout_constraintTop_toBottomOf="@id/tituloCofre" />

                <TextView
                    android:id="@+id/descricaoCofre"
                    style="@style/Texto.Arcade.Corpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_p"
                    android:text="@string/painel_cofre_descricao"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloCofre"
                    app:layout_constraintTop_toBottomOf="@id/tagCofre" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoAbrirCofre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_m"
                    android:text="@string/painel_cofre_botao"
                    android:textColor="@color/texto_sobre_neon"
                    app:backgroundTint="@color/neon_laranja"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloCofre"
                    app:layout_constraintTop_toBottomOf="@id/descricaoCofre" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Painel 4 · Randomizador -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelRandomizador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_g"
            app:strokeColor="@color/neon_verde">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/espaco_g">

                <ImageView
                    android:id="@+id/imagemRandomizador"
                    android:layout_width="@dimen/icone_painel"
                    android:layout_height="@dimen/icone_painel"
                    android:contentDescription="@string/cd_randomizador"
                    android:src="@drawable/ic_randomizador"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tituloRandomizador"
                    style="@style/Texto.Arcade.Secao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_g"
                    android:text="@string/painel_rand_titulo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imagemRandomizador"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tagRandomizador"
                    style="@style/Texto.Arcade.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/painel_rand_tag"
                    android:textColor="@color/neon_verde"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloRandomizador"
                    app:layout_constraintTop_toBottomOf="@id/tituloRandomizador" />

                <TextView
                    android:id="@+id/descricaoRandomizador"
                    style="@style/Texto.Arcade.Corpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_p"
                    android:text="@string/painel_rand_descricao"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloRandomizador"
                    app:layout_constraintTop_toBottomOf="@id/tagRandomizador" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoAbrirRandomizador"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_m"
                    android:text="@string/painel_rand_botao"
                    android:textColor="@color/texto_sobre_neon"
                    app:backgroundTint="@color/neon_verde"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tituloRandomizador"
                    app:layout_constraintTop_toBottomOf="@id/descricaoRandomizador" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Regras rápidas: conteúdo extra que também exige rolagem -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRegras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_g">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_g">

                <TextView
                    style="@style/Texto.Arcade.Secao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/central_regras_titulo" />

                <TextView
                    style="@style/Texto.Arcade.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_p"
                    android:text="@string/central_regras_scanner" />

                <TextView
                    style="@style/Texto.Arcade.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_p"
                    android:text="@string/central_regras_arena" />

                <TextView
                    style="@style/Texto.Arcade.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_p"
                    android:text="@string/central_regras_cofre" />

                <TextView
                    style="@style/Texto.Arcade.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_p"
                    android:text="@string/central_regras_rand" />

                <TextView
                    style="@style/Texto.Arcade.Legenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_m"
                    android:text="@string/central_navegacao"
                    android:textColor="@color/neon_ciano" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoEncerrarSessao"
            style="@style/Widget.Arcade.BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_gg"
            android:text="@string/acao_encerrar_sessao"
            android:textColor="@color/neon_magenta"
            app:icon="@drawable/ic_sair"
            app:iconGravity="textStart"
            app:iconTint="@color/neon_magenta"
            app:strokeColor="@color/neon_magenta" />

        <TextView
            android:id="@+id/textoCreditos"
            style="@style/Texto.Arcade.Legenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_g"
            android:layout_marginBottom="@dimen/espaco_p"
            android:gravity="center"
            android:text="@string/creditos" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
