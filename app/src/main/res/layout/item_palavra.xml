<?xml version="1.0" encoding="utf-8"?>
<!-- Item do RecyclerView do Randomizador: palavra e categoria. Funciona em lista e em grade. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espaco_xs"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espaco_m">

        <View
            android:id="@+id/indicadorCategoria"
            android:layout_width="4dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tile"
            android:backgroundTint="@color/neon_magenta" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoPalavra"
                style="@style/Texto.Arcade.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/arcade_texto"
                android:textStyle="bold"
                tools:text="Interestelar" />

            <TextView
                android:id="@+id/textoCategoria"
                style="@style/Texto.Arcade.Overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Filmes" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
