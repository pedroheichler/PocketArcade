<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Seis Activities, sem permissão de internet: tudo roda localmente.
         As telas ficam em retrato para que girar o celular não reinicie as partidas. -->
    <application
        tools:ignore="DiscouragedApi,LockedOrientationActivity"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketArcade">

        <!-- Tela 1 · Apresentação (raiz da pilha) -->
        <activity
            android:name=".ApresentacaoActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela 2 · Central de Desafios -->
        <activity
            android:name=".CentralActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Telas 3 a 6 · Desafios -->
        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ArenaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CofreActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RandomizadorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
